{
  "name": "@ofauth/onlyfans-sdk",
  "version": "4.0.0-rc.1",
  "description": "OFAuth V3 TypeScript SDK: OAuth (Link), typed Access and Vault+ operations, webhooks, and Realtime",
  "keywords": [
    "ofauth",
    "onlyfans",
    "onlyfans-api",
    "oauth",
    "sdk",
    "webhooks"
  ],
  "homepage": "https://docs.ofauth.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/OFAuth-org/onlyfans-sdk-typescript"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./realtime-browser": {
      "import": {
        "types": "./dist/realtime-browser.d.mts",
        "default": "./dist/realtime-browser.mjs"
      },
      "require": {
        "types": "./dist/realtime-browser.d.ts",
        "default": "./dist/realtime-browser.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ],
      "realtime-browser": [
        "./dist/realtime-browser.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts src/realtime-browser.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
